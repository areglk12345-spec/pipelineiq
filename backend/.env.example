# Supabase project connection string (Settings -> Database -> Connection string -> URI)
# Use the "Session" pooler or direct connection; both work with node-postgres.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Set to "true" for Supabase (required) or self-managed Postgres with a self-signed cert.
PGSSL=true

# Long random secret, e.g. `openssl rand -hex 32`
JWT_SECRET=changeme-generate-a-real-secret

# Access token lifetime, matches the mock's "Session Timeout 30 minutes" setting
JWT_EXPIRES_IN=30m

# 64-char hex (32 bytes), e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Encrypts two_fa_secret at rest (AES-256-GCM) — rotating this key invalidates
# every enrolled account's 2FA (they'd need to re-enroll).
TOTP_ENCRYPTION_KEY=changeme-generate-a-real-32-byte-hex-key

PORT=4000

# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:8098
